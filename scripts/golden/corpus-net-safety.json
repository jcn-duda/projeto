    {"id":"ns-003","input":"{\"raw\":\"magnet:?xt=urn:btih:aabbccddeeff00112233445566778899aabbccdd&dn=Name\",\"allowPrivate\":false}","note":"magnet não é download http"},
    {"id":"ns-004","input":"{\"raw\":\"\",\"allowPrivate\":false}","note":"string vazia"},
    {"id":"ns-005","input":"{\"raw\":\"http://localhost/test\",\"allowPrivate\":false}","note":"localhost"},
    {"id":"ns-006","input":"{\"raw\":\"http://127.0.0.1/api\",\"allowPrivate\":false}","note":"loopback 127.0.0.1"},
    {"id":"ns-007","input":"{\"raw\":\"http://10.1.2.3/a\",\"allowPrivate\":false}","note":"10/8"},
    {"id":"ns-008","input":"{\"raw\":\"http://192.168.1.10/file\",\"allowPrivate\":false}","note":"192.168/16"},
    {"id":"ns-009","input":"{\"raw\":\"http://172.16.0.1/download\",\"allowPrivate\":false}","note":"172.16/12"},
    {"id":"ns-010","input":"{\"raw\":\"http://169.254.169.254/latest/meta-data\",\"allowPrivate\":false}","note":"link-local metadata 169.254.169.254"},
    {"id":"ns-011","input":"{\"raw\":\"http://0.0.0.0/api\",\"allowPrivate\":false}","note":"0.0.0.0"},
    {"id":"ns-012","input":"{\"raw\":\"http://224.0.0.1/multicast\",\"allowPrivate\":false}","note":"multicast 224/4"},
    {"id":"ns-013","input":"{\"raw\":\"http://[::1]/file\",\"allowPrivate\":false}","note":"loopback ::1"},
    {"id":"ns-014","input":"{\"raw\":\"http://[fc00::1]/file\",\"allowPrivate\":false}","note":"ULA fc00"},
    {"id":"ns-015","input":"{\"raw\":\"http://[fe80::1]/file\",\"allowPrivate\":false}","note":"link-local fe80"},
    {"id":"ns-016","input":"{\"raw\":\"http://[::ffff:127.0.0.1]/file\",\"allowPrivate\":false}","note":"IPv4-mapeado de loopback"},
    {"id":"ns-017","input":"{\"raw\":\"http://192.168.1.1/file\",\"allowPrivate\":true}","note":"allowPrivate true num host privado"},
