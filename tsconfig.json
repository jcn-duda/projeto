{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": true,
    // Portão rearmado no fim da rodada 2: os 56 @ts-nocheck de test/ saíram,
    // o projeto inteiro está em 0 erros e o build volta a falhar (exit 1) se
    // qualquer erro de tipo voltar a entrar.
    "noEmitOnError": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "spike-esm",
    "bludv-resolver",
    "comandotorrents-resolver",
    "nerdfilmes-resolver",
    "torrentdosfilmes-resolver",
    "vacatorrent-resolver"
  ]
}
