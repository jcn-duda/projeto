    { "id": "set-dupes", "form": "set", "cached": ["h1", "h2", "h1"] },
    { "id": "object-complete-true", "form": "object", "cached": ["h1"], "complete": true },
    { "id": "object-complete-false", "form": "object", "cached": ["h1", "h2"], "complete": false },
    { "id": "object-complete-omitted", "form": "object", "cached": ["h1"] },
    { "id": "object-complete-null", "form": "object", "cached": ["h1"], "complete": null },
    { "id": "object-dupes", "form": "object", "cached": ["h1", "h1"], "complete": true },
    { "id": "empty-set-known-true", "form": "set", "cached": [] },
    { "id": "empty-object-complete-true", "form": "object", "cached": [], "complete": true },
    { "id": "empty-object-complete-false", "form": "object", "cached": [], "complete": false }
