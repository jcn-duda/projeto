{
  "name": "stremio-adom",
  "version": "1.0.0",
  "type": "module",
  "description": "Addon Stremio self-hosted: torrents via Jackett/Prowlarr + Docker",
  "main": "dist/src/addon.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc && tsc -p tsconfig.client.json && tsc -p tsconfig.client.test.json && node dist/scripts/build-assets.js",
    "start": "node dist/src/addon.js",
    "dev": "tsc && tsc -p tsconfig.client.json && tsc -p tsconfig.client.test.json && node --watch dist/src/addon.js",
    "smoke": "node dist/scripts/smoke.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.client.test.json",
    "pretest": "npm run build",
    "test": "node dist/scripts/run-tests.js",
    "test:complete": "node dist/scripts/check-test-list.js",
    "lint:lines": "node dist/scripts/check-line-budget.js",
    "test:stress": "node dist/test/m1-stress-challenge.js && node dist/test/m1-stress-challenge-protectors.js && node dist/test/stress-m1-challenger.js",
    "test:adversarial": "node dist/test/empirical-e2e-challenger.js",
    "test:adversarial-m1": "node dist/test/adversarial-m1-parser-harness.js && node dist/test/adversarial-m1-parser-part2.js",
    "test:protector-m1": "node --test dist/test/m1-protector-adversarial-stress.js dist/test/m1-protector-adversarial-part2.js",
    "test:challenger-m2": "node dist/test/challenger-m2-parser-deep-stress.js",
    "test:ranking-challenger": "node dist/scripts/empirical-ranking-challenger.js",
    "test:nerdfilmes": "node dist/nerdfilmes-resolver/test.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f adom"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "stremio",
    "addon",
    "torrent",
    "jackett",
    "prowlarr",
    "docker"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.2"
  },
  "overrides": {
    "path-to-regexp": "^0.1.13",
    "qs": "^6.16.0"
  },
