# Container único: o Caddy roda no mesmo processo-namespace do addon,
# então o upstream é o loopback — não existe mais hostname "addon".
#
# O domínio vem do ADDON_DOMAIN no .env. O default `localhost` existe para a
# instalação em casa: com ele o Caddy emite um certificado interno e NÃO chama
# o Let's Encrypt. Deixar um domínio real fixo aqui fazia a máquina de casa
# pedir certificado para um nome cujo DNS aponta para a VPS — falha em loop e
# gasta a cota de erro do ACME.
#
# Na VPS, ANTES de subir:
#   .env:  ADDON_DOMAIN=powermovie.net, www.powermovie.net
#   DNS:   A powermovie.net -> IP da VPS   (e o www também)
# Sem o DNS resolvendo, o desafio ACME falha e a stack sobe sem HTTPS.
{$ADDON_DOMAIN:localhost} {
	# A URL de instalação carrega a chave do debrid no segmento de config.
	# É por isso que a porta 7000 fica no loopback (BIND_ADDR no compose) e
	# tudo entra por aqui: fora do TLS essa chave iria em texto puro.
	#
	# /configure e /defaults.json são públicos de propósito (qualquer um gera
	# install URL nesta instância). O token de diagnóstico do painel NÃO passa
	# por aqui — ele continua só no header das rotas JSON do addon.
	reverse_proxy 127.0.0.1:7000
}
