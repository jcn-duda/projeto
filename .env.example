# Porta local do addon Adom (o container sempre escuta em 7000)
PORT=7000
HOST=0.0.0.0

# Nome que aparece no Stremio
ADDON_NAME=Stremio Adom
ADDON_ID=community.stremio.adom

# Provedor de busca: jackett | prowlarr | both | demo
# demo = só Big Buck Bunny (teste sem Jackett)
PROVIDER=demo

# --- Jackett (opcional) ---
# URL interna no Docker: http://jackett:9117
# URL local no PC: http://127.0.0.1:9117
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=

# --- Prowlarr (opcional) ---
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=

# Filtros de qualidade (vírgula). Vazio = todos
# Ex: 2160p,1080p,720p,WEB,BluRay
QUALITY_FILTER=

# Mínimo de seeders (0 = sem filtro)
MIN_SEEDERS=1

# Máximo de streams por título
MAX_RESULTS=40

# Cache em segundos (0 = desligado)
CACHE_TTL=900

# Timeout de cada busca em indexer (ms). O cliente Stremio aborta em 10s,
# então mantenha ambos abaixo disso.
SEARCH_TIMEOUT_MS=8000
# Prazo pra responder ao Stremio; passando disso devolve vazio e a busca
# continua em background, populando o cache pra próxima tentativa.
REPLY_DEADLINE_MS=8500

# --- Comet / PostgreSQL ---
# Obrigatórias na VPS: use senhas longas, aleatórias e exclusivas. Nunca
# versione o .env. POSTGRES_PASSWORD vazio impede o Compose de iniciar.
POSTGRES_PASSWORD=
ADMIN_DASHBOARD_PASSWORD=
CONFIGURE_PAGE_PASSWORD=

# Adicione a chave Real-Debrid individualmente em
# https://comet.seudominio.com/configure; a página gera um manifest privado.

# O Comet reutiliza JACKETT_API_KEY acima e descobre indexers saudáveis.
SCRAPE_JACKETT=true
SCRAPE_PROWLARR=false

# --- Debrid (opcional): premiumize | vazio = P2P puro ---
DEBRID_SERVICE=
DEBRID_API_KEY=
# true = só resultados cacheados no debrid (play instantâneo)
DEBRID_CACHED_ONLY=true
DEBRID_BATCH_SIZE=100
DEBRID_TIMEOUT_MS=6000
# URL pública do addon — precisa ser alcançável pelo player
PUBLIC_URL=http://127.0.0.1:7000

# Indexers consultados em paralelo, um timeout por indexer.
# Vazio = usa o agregado /all do Jackett, que espera o indexer mais lento.
JACKETT_INDEXERS=
JACKETT_INDEXER_TIMEOUT_MS=4000

# --- BLUDV (fonte BR dublada) ---
BLUDV_ENABLED=false
BLUDV_DUBBED_ONLY=true
BLUDV_MAX_POSTS=3
BLUDV_TIMEOUT_MS=8000

# --- TMDB: resolve título pt-BR (necessário para fontes BR) ---
TMDB_API_KEY=
TMDB_CACHE_TTL=604800
