# Porta local do addon Adom (o container sempre escuta em 7000)
PORT=7000
HOST=0.0.0.0

# Nome que aparece no Stremio
ADDON_NAME=Adom Power-Movie
ADDON_ID=community.stremio.adom

# Provedor de busca: jackett | prowlarr | torrentio | both | demo (ou uma lista
# com os nomes, ex.: "jackett+prowlarr+torrentio" ou "jackett,torrentio").
# demo = só Big Buck Bunny (teste sem Jackett)
# torrentio só roda junto de uma fonte de busca real; com demo é ignorado.
# Quando PROVIDER é jackett/prowlarr/both e TORRENTIO_ENABLED=true, o torrentio
# entra por padrão nas instalações novas.
PROVIDER=demo

# --- Torrentio (pool global público, Fase 1) ---
# Consulta a API pública do Torrentio (sem config nem credencial de debrid) para
# achar releases já indexadas no acervo global. Nenhuma chave do usuário sai do
# processo; falha/timeout só degrada a coleta (devolve vazio), nunca derruba.
TORRENTIO_ENABLED=true
TORRENTIO_URL=https://torrentio.strem.fun
# Teto por consulta; a fonte respeita o orçamento geral da coleta.
TORRENTIO_TIMEOUT_MS=1500
# Circuit breaker local: N falhas seguidas abrem o circuito por este cooldown;
# sucesso reseta a contagem.
TORRENTIO_BREAKER_FAILURES=3
TORRENTIO_BREAKER_COOLDOWN_MS=300000

# --- Jackett (opcional) ---
# No compose de container único o Jackett roda DENTRO do mesmo container que o
# addon, então o certo é o loopback: http://127.0.0.1:9117
# (o antigo hostname http://jackett:9117 só existia no compose multi-container).
# Rodando o addon fora do Docker com um Jackett externo, use a URL dele aqui.
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=
# Protege /test-indexer.json e /metrics.json. Gere um segredo aleatório; vazio
# desliga os diagnósticos operacionais.
JACKETT_TEST_TOKEN=

# --- Prowlarr (opcional, EXTERNO) ---
# O compose de container único não sobe o Prowlarr; se quiser usar, aponte
# para uma instância própria e inclua prowlarr no PROVIDER.
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=

# Filtros de qualidade (vírgula). Vazio = todos
# Ex: 2160p,1080p,720p,WEB,BluRay
QUALITY_FILTER=

# Mínimo de seeders (0 = sem filtro)
MIN_SEEDERS=1

# Dublado antes de legendado DENTRO da mesma qualidade (o usuário ainda pode
# desligar no install URL). Ligado: as cotas por qualidade não distinguem
# áudio, então desligado três legendadas do mesmo post enchiam a cota do 1080p
# e empurravam a release dublada para fora da lista.
PREFER_DUBBED=true

# Máximo de streams por título
MAX_RESULTS=40
# Padrão por qualidade exibido na configuração. O usuário ainda pode mudar cada
# cota no install URL; 100 significa sem limite e 0 esconde o grupo.
MAX_STREAMS_2160P=6
MAX_STREAMS_1080P=6
MAX_STREAMS_720P=6
MAX_STREAMS_480P=6
MAX_STREAMS_SD=6
MAX_STREAMS_UNKNOWN=6

# Teto de streams por indexador na lista final (0 = sem limite). Impede que uma
# fonte com muitos resultados (YTS, TheRARBG) ocupe quase todas as vagas.
# Atenção: aqui 0 é "desligado", ao contrário das cotas acima, onde 0 é "nenhum".
# As vagas de BR_RESERVED_SLOTS passam mesmo acima deste teto.
MAX_STREAMS_PER_INDEXER=0
# Quantos candidatos por vaga final o sortAndLimit considera antes do corte
# real (pool = MAX_RESULTS × este fator). Sem a ampliação, fontes BR — que
# não publicam seeders — morreriam na ordenação antes das vagas reservadas.
CANDIDATE_POOL_FACTOR=4
# Vagas garantidas para fontes BR dubladas na lista final: cortadas só por
# relevância e pelo MAX_RESULTS. A reserva fura o teto do MAX_STREAMS_PER_INDEXER
# E a cota por qualidade acima -- e não consome nenhum dos dois, então as globais
# mantêm o balde inteiro delas. Com a cota em 2 e a reserva em 4: 4 BR + 2 globais.
BR_RESERVED_SLOTS=6
# Reserva BR POR FAIXA de qualidade: garante até N fontes BR (dublado primeiro)
# por balde (2160p/1080p/720p…), para o 1080p BR abundante não consumir as
# vagas e a faixa 4K/720p ficar sem BR quando existe fonte. 0 restaura a
# reserva única global.
BR_RESERVED_PER_QUALITY=1

# Cache em segundos (0 = desligado)
CACHE_TTL=900
# SQLite só preserva o cache entre restarts; false mantém apenas o L1 em memória.
CACHE_PERSIST=true
# Caminho do SQLite. Vazio usa data/cache.db relativo ao checkout/build.
CACHE_DB_PATH=data/cache.db

# --- Cache do resultado BRUTO da busca (Fase 1 do cache multi-nível) ---
# Guarda a resposta crua dos indexers/scrapers, sem credencial nem config do
# usuário: duas instalações com configs diferentes do mesmo título passam a
# compartilhar a raspagem. Falha nunca é cacheada (o circuit breaker segue
# sendo a resposta pra indexer fora). 0 desliga cada camada.
RAW_CACHE_TTL=900
# Indexers pt-BR raspam WordPress e pagam protetor de link (20s de orçamento):
# custam mais e mudam menos, então vivem mais tempo no cache.
RAW_CACHE_TTL_BR=1800
# 200 com zero itens pode ser rate-limit disfarçado: TTL curto separado, senão
# um indexer travado congela o vazio pelo TTL inteiro. 0 = vazio não cacheia.
RAW_CACHE_EMPTY_TTL=120
# Teto de itens por entrada bruta (pior caso real medido: 862 bytes/item).
# Resultados maiores que isso não são cacheados; 0 desliga o cache bruto.
RAW_CACHE_MAX_ITEMS=120

# --- Stale-while-revalidate das listas de stream (Fase 2 do cache multi-nível) ---
# Depois do CACHE_TTL, a lista expirada ainda é servida na hora enquanto um
# refresh de fundo a reconstrói. Só vale para lista completa com debrid
# conferido e stream tocável (aviso e lista parcial não entram).
# 0 volta à semântica dura: expirou = busca nova síncrona.
STREAM_STALE_GRACE_SECONDS=300

# Timeout de cada busca em indexer (ms). O cliente Stremio aborta em 10s,
# então mantenha ambos abaixo disso.
SEARCH_TIMEOUT_MS=8000
# Prazo pra responder ao Stremio; passando disso devolve vazio e a busca
# continua em background, populando o cache pra próxima tentativa.
REPLY_DEADLINE_MS=9200
# Fatia do REPLY_DEADLINE reservada pra checagem de cache no debrid; o que sobra
# é o orçamento da coleta nos indexers. Dimensionada pelo serviço mais lento em
# uso: Premiumize medido em 1,9-4,7s por checagem (mediana ~3,2s) — reserva
# menor que a mediana perdia a corrida e a lista inteira saía sem ⚡. O custo é
# a coleta encolher (9200-4500=4700ms): fonte BR lenta cai mais no passe tardio,
# que já é o caminho dela. NÃO compense subindo o REPLY_DEADLINE_MS (o cliente
# aborta perto de 10s). O teto DEBRID_CACHE_CHECK_TIMEOUT_MS segue deliberadamente
# maior: é do passe tardio.
DEBRID_RESERVE_MS=4500
# Piso intocavel da checagem de cache: a janela extra BR nunca desce disto.
# Medida real na AllDebrid: 270-290ms, entao 1500 ja tem folga de 5x.
DEBRID_CHECK_FLOOR_MS=1500
# Janela extra, tirada da reserva do debrid, quando o lote parcial ainda não tem
# nenhuma fonte BR. O que ela pode consumir é limitado pelo piso acima
# (DEBRID_RESERVE_MS - DEBRID_CHECK_FLOOR_MS), não por este número sozinho.
BR_PARTIAL_GRACE_MS=1500

# --- Fechar /configure numa instância exposta ---
# Não existe autenticação no addon: /configure e /defaults.json são públicos, e
# com o selo ligado qualquer um também gera install URL na sua instância. Quem
# quiser fechar usa o basic_auth comentado no Caddyfile — é o único caminho que
# funciona. (Aqui já existiram ADMIN_DASHBOARD_PASSWORD e CONFIGURE_PAGE_PASSWORD:
# nenhum código jamais as leu, então foram removidas em vez de seguir prometendo
# uma proteção que não existe.)

# --- Debrid (opcional) ---
# premiumize | realdebrid | alldebrid | torbox | debridlink | vazio = P2P puro
# Respondem consulta de cache: premiumize, torbox e alldebrid. Real-Debrid e
# Debrid-Link não respondem — neles todo resultado passa pelo debrid, ninguém
# recebe ⚡ e DEBRID_CACHED_ONLY é ignorado.
DEBRID_SERVICE=
DEBRID_API_KEY=
# Em instância pública, use false para nunca herdar a chave do operador quando
# o install URL não declarar dk. Cada usuário configura e sela a própria chave.
DEBRID_ALLOW_ENV_KEY=true
# true = só resultados cacheados no debrid (play instantâneo)
# Na AllDebrid a consulta de cache é um upload de verdade. Quando sobra orçamento
# ela disputa a primeira resposta sem ser abortada: se terminar a tempo, o ⚡ e
# o filtro já valem na lista aberta; se não, termina e limpa em background.
# Se preferir ver também os não cacheados, use false.
DEBRID_CACHED_ONLY=true
# Opt-in: mantém até BR_RESERVED_SLOTS fontes brasileiras como P2P quando
# ainda não estão no cache. Globais fora do cache continuam escondidos.
# Off por padrão: "somente em cache" segue só instantâneo (web/TV sem torrent).
DEBRID_SHOW_UNCACHED_BR=false
# Cliente que so toca URL (web, algumas TVs, apps que descartam stream sem
# `url`) enxerga ZERO num titulo sem nada em cache: o nao-cacheado sai como
# infoHash puro e some da tela, mesmo com a busca cheia. Ligue isto e o frio
# tambem sai pelo /resolve, marcado "[AD download]" — o modelo do Torrentio,
# em que o play e quem adiciona o magnet no debrid. Off por padrao porque
# escrever na conta a cada play de fonte fria e justamente o que o modo padrao
# evita. O raio nunca vai no frio: ele continua sendo promessa de play imediato.
DEBRID_RESOLVE_UNCACHED=false
# --- Cache de disponibilidade por hash (Fase 3) ---
# Resultado confirmado em cache por conta. 0 desliga a leitura e escrita positiva.
DEBRID_AVAIL_POS_TTL=900
# Resultado confirmado fora do cache. TTL curto deixa downloads do autofetch
# voltarem a ser conferidos logo; 0 desliga a leitura e escrita negativa.
DEBRID_AVAIL_NEG_TTL=120
# Remove da conta do debrid o que a checagem descobriu NÃO estar em cache.
# Sem isso, cada consulta deixa um download fantasma rodando (na AllDebrid a
# checagem é um upload de verdade). O download do autofetch fica protegido.
DEBRID_DROP_UNCACHED=true
# Inventário AllDebrid que protege o acervo do usuário da limpeza. Ao vencer, a
# busca dispara a atualização EM FUNDO e não apaga nada até a foto nova chegar
# (a espera ficaria dentro da reserva do debrid). 0 desliga a expiração — não
# recomendado: o snapshot congelaria e autorizaria apagar o que o usuário
# adicionou na conta depois do boot.
ALLDEBRID_PREEXISTING_TTL_MS=300000
# Lotes da checagem de cache (paralelos, cada um com o teto completo). Não é
# aceleração — é degradação parcial: com 1 lote só, estourar o prazo zerava o
# Set e a lista inteira perdia o ⚡; com lotes menores, o lote que responde
# marca os seus itens. Muito pequeno dispara rate limit no Premiumize; 25 é o
# ponto de partida medido.
DEBRID_BATCH_SIZE=25
DEBRID_TIMEOUT_MS=6000
# Teto completo da checagem no PASSE TARDIO (os lotes vão em paralelo). Pode
# passar do REPLY_DEADLINE_MS porque já não segura a resposta. O passo inicial
# usa o orçamento dinâmico abaixo; o fundo repete com este teto e restaura
# ⚡/cachedOnly no cache.
DEBRID_CACHE_CHECK_TIMEOUT_MS=10000
# Teto dinamico da checagem de cache no PASSO DE RESPOSTA: o que resta do
# REPLY_DEADLINE menos esta margem. Quando a coleta fria consome o orcamento
# inteiro, a checagem degrada para known:false e a lista sai nao-vazia via
# debrid em vez de o deadline devolver []. O passe tardio segue com o teto
# completo (DEBRID_CACHE_CHECK_TIMEOUT_MS) e grava a lista marcada no cache.
DEBRID_CHECK_FORMAT_MARGIN_MS=500
# Piso de orçamento para tentar na primeira resposta uma checagem que não pode
# ser abortada (AllDebrid). Abaixo dele o passe tardio assume sem atrasar a lista.
DEBRID_NON_ABORTABLE_RACE_MIN_MS=400
# Sem nenhuma fonte BR dublada em cache, manda o debrid baixar a melhor (UM
# torrent por titulo). So funciona em servico que informa cache (Premiumize,
# TorBox e AllDebrid): nos outros nao ha como saber o que falta, e neles o play
# ja adiciona o magnet sozinho. O TTL evita reenviar a cada busca e e por
# quanto tempo o hash fica protegido do DEBRID_DROP_UNCACHED, que senao
# apagaria da conta o download que acabamos de comecar.
DEBRID_AUTO_FETCH_BR=true
# Fallback quando a busca nao achou NENHUMA fonte BR dublada (site fora,
# dominio mudou, titulo nao indexado): baixa a melhor global com
# dublado/dual/nacional no titulo — sem isso, busca BR vazia significava nao
# baixar nada. So dispara quando NENHUM stream da lista toca na hora.
DEBRID_AUTO_FETCH_ANY=true
DEBRID_AUTO_FETCH_TTL=21600
# Quantos torrents BR dublados o autofetch baixa em background por busca
# (uma vaga por candidato, compartilhada entre o passe parcial e o tardio).
# Mais candidatos = mais chances de um play pronto depois, ao custo de encher
# mais a conta. Faixa 1..4 (default 4); 0 NAO desliga — quem desliga é o toggle
# DEBRID_AUTO_FETCH_BR acima.
DEBRID_AUTO_FETCH_MAX=4
# Terceiro nível: sem BR dublado e sem dublado global em lugar nenhum, baixa os
# melhores por seeders — filme ou série. É a rede de segurança do título que não
# tem dublagem alguma: sem ela, com "somente já em cache" ligado, a lista chega
# vazia e nada é baixado para a próxima busca. Só dispara quando NADA está
# tocável, e nunca escolhe CAM. O piso evita torrents com 0-1 pares, que morrem
# na fila do debrid.
DEBRID_AUTO_FETCH_TOP_SEEDS=true
DEBRID_AUTO_FETCH_TOP_SEEDS_MAX=2
DEBRID_AUTO_FETCH_MIN_SEEDERS=3
# Preferencia PT no pool de swarm: release com sinal de portugues (dublado,
# nacional, acentos, vocabulario de post BR) vence a contagem bruta de
# seeders. E preferencia, nao filtro: sem nenhum candidato PT, seeders decide.
DEBRID_AUTO_FETCH_SEEDS_PT_FIRST=true
# Recheck pos-enfileiramento: depois de aceitar um torrent, o addon pergunta ao
# debrid de novo a cada N ms (ate RECHECK_MAX tentativas) se o download ja
# toca — sem o teto do deadline de resposta, e um passe de fundo. Quando fica
# pronto, o cache da busca e esquecido para a proxima pergunta do cliente
# reconstruir a lista com o raio, em vez de esperar o CACHE_TTL inteiro.
# 0 em qualquer um dos dois desliga o recheck.
DEBRID_AUTO_FETCH_RECHECK_MS=120000
DEBRID_AUTO_FETCH_RECHECK_MAX=3
# Torrent "running" com progresso ausente/0 e mensagem "0 Bytes of 0 Bytes" /
# "from 0 peer" esta PARADO, nao baixando. Apos N rechecks consecutivos assim,
# o recheck o trata como morto (blacklist, remocao e dreno da fila) — a falta
# de pares pode ser transitoria, por isso o limiar proprio em vez de matar na
# primeira observacao. 0 desliga a deteccao: parado nunca derruba o download.
DEBRID_AUTO_FETCH_STALL_STREAK=3
# Quando pack de temporada fica pronto, invalida episodios ja buscados da mesma
# temporada/conta e semeia disponibilidade para o raio voltar sem esperar CACHE_TTL.
DEBRID_AUTO_FETCH_SEASON_FILL=true
# Teto LRU de temporadas no indice em memoria; 0 desliga o indice.
DEBRID_AUTO_FETCH_SEASON_INDEX_MAX=200
# Teto de chaves de busca indexadas por temporada/conta. Cada install da mesma
# conta e uma chave; conta compartilhada por muitas URLs pode precisar de mais.
DEBRID_AUTO_FETCH_SEASON_INDEX_KEYS=256
# Fila persistente de candidatos excedentes e drenagem automatica de mortos
DEBRID_AUTO_FETCH_QUEUE=true
DEBRID_AUTO_FETCH_QUEUE_DEPTH=6
DEBRID_AUTO_FETCH_DEAD_TTL=86400
DEBRID_AUTO_FETCH_SETTLE_MS=900000
DEBRID_AUTO_FETCH_SETTLE_MAX_LOTS=50
DEBRID_AUTO_FETCH_QUEUE_TTL=86400
# Pausa a drenagem quando o limite horário foi atingido, evitando reprocessar a
# mesma cabeça da fila até a janela deslizante voltar a ter vaga.
DEBRID_AUTO_FETCH_DRAIN_BACKOFF_MS=60000
DEBRID_AUTO_FETCH_ENQUEUE_MAX_HOUR=50
DEBRID_AUTO_FETCH_DRAIN_MAX_REFUSALS=2
# Gate de ocupacao da conta: com este numero de magnets ou mais o autofetch
# para de enfileirar (backpressure), evitando empurrar a conta ao teto que
# derruba a checagem de cache e o raio junto. 0 desliga o gate.
DEBRID_AUTO_FETCH_PAUSE_AT=800
# Validade do memo de ocupacao do gate: vencida, a contagem e renovada em
# background (fail-open enquanto o refresh nao volta; nunca rede no caminho
# sincrono da resposta).
DEBRID_AUTO_FETCH_PAUSE_REFRESH_MS=900000
# Prefetch do proximo episodio de series em background
DEBRID_PREFETCH_NEXT_EP=true
DEBRID_PREFETCH_TTL=43200
# Sonda em fundo no Real-Debrid (substituto do instantAvailability aposentado).
# Mede addMagnet→downloaded na conta, grava ⚡ no magnetdb e apaga o torrent da
# sonda. Fora do caminho da resposta. false desliga.
DEBRID_RD_PROBE=true
DEBRID_RD_PROBE_MAX=2
DEBRID_RD_PROBE_MAX_HOUR=40
DEBRID_RD_PROBE_GAP_MS=800
DEBRID_RD_PROBE_INITIAL_DELAY_MS=15000
DEBRID_RD_PROBE_RATE_COOLDOWN_MS=90000
DEBRID_RD_PROBE_MISS_TTL_MS=120000
# Ledger durável GLOBAL de disponibilidade do CDN Real-Debrid. Não é por conta:
# uma confirmação do serviço vale para instalações diferentes. Miss só faz
# backoff de sonda (nunca filtra stream), porque falso negativo é pior.
DEBRID_RD_LEDGER=true
DEBRID_RD_LEDGER_HIT_TTL=2592000
DEBRID_RD_LEDGER_BLOCKED_TTL=2592000
DEBRID_RD_LEDGER_MISS_BACKOFF_MS=1800000,7200000,43200000,259200000
# Oráculo externo do cache global do Real-Debrid (consulta o CDN em fontes de
# terceiro: StremThru e Torrentio) — mas isso acontece SOMENTE em fontes
# configuradas DELIBERADAMENTE. Por padrao as fontes ficam OFF (stremthruUrl
# vazio e TORRENTIO=false), entao nenhuma credencial sai do processo sem
# endpoint/flag explicito. Para habilitar, defina o endpoint/flag da fonte e,
# opcionalmente, um token/key proprio (chave explicita tem precedencia; vazia,
# usa a apiKey efetiva da instalacao como Bearer/token — terceiros a veem).
# Kill-switches: DEBRID_RD_ORACLE=false derruba o oraculo inteiro; sem oraculo
# nem ledger, o RD volta ao comportamento honesto "nao sei" (sem cacheCheck).
DEBRID_RD_ORACLE=true
# Prazo UNICO de toda a chamada do oraculo, compartilhado pelas fontes em
# paralelo. Nao soma por lote/fonte — cada lote StremThru usa so o restante e
# nao inicia lote depois do prazo; o Torrentio usa o mesmo restante.
DEBRID_RD_ORACLE_TIMEOUT_MS=800
# Teto de hashes por chamada StremThru (max confirma 500 por requisicao).
DEBRID_RD_ORACLE_MAX_HASHES=100
# Endpoint StremThru. VAZIO no runtime generico (nenhuma credencial sai sem
# endpoint explicito). O docker-compose injeta http://stremthru:8080, a instancia
# self-hosted da propria stack. Fora dele, defina deliberadamente um endpoint.
# Token explicito tem precedencia; vazio usa a apiKey da instalacao. Envelope
# data.items[]. Kill-switch global: DEBRID_RD_ORACLE=false.
DEBRID_RD_ORACLE_STREMTHRU_URL=
DEBRID_RD_ORACLE_STREMTHRU_TOKEN=
DEBRID_RD_ORACLE_STREMTHRU_STORE=realdebrid
# Fonte Torrentio. O segmento de config e TEXTO PURO "realdebrid=<key>", nao
# base64url. Key explicita tem precedencia; vazia usa a apiKey da instalacao.
# FALSE por padrao (opt-in): o URL abaixo permanece como default, mas so e
# consultado com este flag true E credencial efetiva.
DEBRID_RD_ORACLE_TORRENTIO=false
DEBRID_RD_ORACLE_TORRENTIO_URL=https://torrentio.strem.fun
DEBRID_RD_ORACLE_TORRENTIO_KEY=
DEBRID_RD_ORACLE_TORRENTIO_TTL=21600
# Governador por conta para escritas Real-Debrid. false restaura o fluxo
# anterior, inclusive o gap e o cooldown locais da sonda.
DEBRID_RD_GATE=true
DEBRID_RD_GATE_MIN_GAP_MS=1000
DEBRID_RD_GATE_MAX_GAP_MS=30000
DEBRID_RD_GATE_COOLDOWN_MS=90000
# Após este teto, play fura apenas gap/cooldown; não preempta job já em voo.
DEBRID_RD_GATE_PLAY_MAX_WAIT_MS=1500
# Warmer contínuo em fundo para Real-Debrid (Fase F3).
# Consome hashes desconhecidos da fila em background, mantendo o ledger aquecido
# sem atrasar a resposta e respeitando o limite de taxa do serviço.
DEBRID_RD_WARM=true
DEBRID_RD_WARM_INTERVAL_MS=30000
DEBRID_RD_WARM_BATCH=10
DEBRID_RD_WARM_MAX_HOUR=300
DEBRID_RD_WARM_IDLE_WINDOW_MS=120000
DEBRID_RD_WARM_QUEUE_MAX=5000
# A conta do debrid como fonte de busca: o que ja esta PRONTO la entra com o
# raio sem depender de indexer nenhum — inclusive pack de franquia que o
# casamento estrito dos trackers rejeitaria (medido: "FILMOGRAFIA COMPLETA
# JORNADA NAS ESTRELAS" pronto na conta e invisivel). So AllDebrid e TorBox
# expõem inventario; nos demais servicos e no-op.
DEBRID_INVENTORY_SOURCE=true
# Validade do inventario memoizado (a conta so muda quando o usuario mexe) e
# teto defensivo de itens lidos (a conta real medida tem 1208 prontos).
DEBRID_INVENTORY_TTL=300
DEBRID_INVENTORY_MAX=3000
# Teto da fonte dentro da busca: a primeira leitura custa ~700ms; estourou, a
# tarefa devolve [] e a proxima busca pega do memo aquecido no boot.
DEBRID_INVENTORY_TIMEOUT_MS=1500
# A checagem de cache da AllDebrid e um upload de verdade: sem remover TAMBEM
# os magnets que voltaram prontos, cada busca deixa dezenas na conta para
# sempre (medido: 2300 em quatro dias, ate estourar o teto do servico e derrubar
# a checagem inteira — e ai o raio some de TODOS os streams). Apagar nao custa
# cache: ele e do servico, e o play reenvia o hash na hora. Ficam de fora o
# download do autofetch e o que ja era seu na conta (inventariado no boot).
DEBRID_DROP_READY=true
# Varredura dos magnets em estado terminal ("No peer after 30 minutes",
# "Expired", "File not available"). O DROP_READY/DROP_UNCACHED so alcanca
# hashes que estao NA busca do momento; torrent que morreu e ninguem mais
# pesquisa ficava ocupando vaga para sempre (medido: 189 numa conta no teto).
# Roda no boot e a cada intervalo, respeitando o download do autofetch.
# Ao contrario do DROP_READY, NAO poupa o que ja era seu: magnet em estado
# terminal nao e acervo, e vaga esgotada e o que faz a conta recusar com 503
# o proprio delete que a consertaria.
DEBRID_SWEEP_DEAD=true
DEBRID_SWEEP_DEAD_INTERVAL_MS=21600000
# Margem antes de considerar o estado terminal definitivo: evita varrer um
# magnet que a conta acabou de marcar e ainda pode reavaliar.
DEBRID_SWEEP_DEAD_MIN_AGE_MS=1800000
# Varredura dos magnets ANTIGOS sem audio PT (legendado/estrangeiro que o
# autofetch acumulou antes do filtro de audio). Destrutiva sobre conteudo
# tocavel: so toca no que passou da idade minima, nao esta protegido pelo
# autofetch nem no inventario do usuario; inventario frio pula a rodada
# inteira (fail-safe). false desliga tudo (rollback de uma linha).
DEBRID_SWEEP_UNDUBBED=true
DEBRID_SWEEP_UNDUBBED_INTERVAL_MS=21600000
# Idade minima: so magnet mais antigo que isso entra na varredura (7 dias).
DEBRID_SWEEP_UNDUBBED_MIN_AGE_MS=604800000
# Teto por rodada; os mais antigos saem primeiro.
DEBRID_SWEEP_UNDUBBED_MAX=100
# Busca complementar de pack de temporada no passe tardio para episódios fracos.
SEARCH_PACK_TAIL=true
SEARCH_PACK_MIN_SEEDERS=3
# Item informativo quando cachedOnly corta todos os candidatos.
SEARCH_NOTICE_STREAM=true
# A partir de quantos magnets na conta o /debrid-status.json avisa. E um limiar
# NOSSO: a AllDebrid tem dois tetos que nao batem entre si (30 "ativos" na doc,
# 1000 na mensagem de erro real) e nenhum e consultavel.
DEBRID_ACCOUNT_WARN_TOTAL=800
# Fair-use do Premiumize (`limit_used` em 0..1). Aviso no /debrid-status.json
# quando a fração passa daqui. 0 desliga o aviso. Conta no teto devolve
# account_limit_reached (HTTP 200) e a lista degrada para P2P.
DEBRID_ACCOUNT_WARN_LIMIT_USED=0.8
# Teto por consulta de saúde da conta no dashboard. A rota continua com gate
# global de uma operação por vez e degrada o cartão para timeout quando estoura.
DEBRID_DASHBOARD_ACCOUNT_TIMEOUT_MS=3000
# Auditoria proativa no passe tardio: prova os top N candidatos dublados em
# cache listando os arquivos reais no debrid e grava a mesma evidencia do
# play (mag lie + idx.lied). 0 desliga; a prova em si continua sujeita a
# AUDIO_AUDIT=1.
DEBRID_DUB_AUDIT_MAX=2
# Banco de magnets: historico duravel POR HASH (vivo/ruim/mentiroso), escopado por
# servico+conta. "alive" (TTL 7d) nasce de evidencia medida — cacheado no
# debrid ou play que resolveu no /resolve — e desempata a lista a favor do
# play instantaneo. "bad" (TTL 24h) so por falha deterministica do play
# (torrent sem arquivo de video); erro transitorio nunca condena um hash.
# MAGNET_DB=false desliga tudo; TTL 0 desliga cada lado separadamente.
MAGNET_DB=true
MAGNET_ALIVE_TTL=604800
MAGNET_BAD_TTL=86400
# "lie" é prova de que post que prometia dublado contém release EN. Não é
# "bad" (o torrent tem vídeo), por isso tem chave e TTL próprios.
MAGNET_LIE=true
MAGNET_LIE_TTL=604800
# Auditoria conservadora dos nomes reais de arquivo no play. Sem marcador PT
# NUNCA condena sozinho: exige também grupo EN forte. As listas são calibráveis
# sem deploy; AUDIO_AUDIT=false é rollback imediato.
AUDIO_AUDIT=true
AUDIO_AUDIT_PT_MARKERS=dublado,dublada,dublagem,dubbed,dual audio,pt br,ptbr,portugues,portuguese,nacional,fleg
AUDIO_AUDIT_EN_GROUPS=rarbg,killers,ettv,afm72,tovar,evo,megusta,galaxyrg,glxrc,yts,fgt,amzn,dsnp,smi,ntb,roarb,oxy,bae,drs,huzzah

# --- Indice de releases por obra (addon como servidor) ---
# Memoria por obra (idx:v1): o que a busca ja provou existir, filtrado e
# dedupado por hash. Compartilhado entre instalacoes DE PROPOSITO - guarda o
# que EXISTE, nunca o que esta pronto em qual conta (isso e davail/mag).
# RELEASE_INDEX=false desliga escrita e leitura; TTL 0 idem.
RELEASE_INDEX=true
# Release nao deixa de existir por envelhecer: 30 dias e esquecimento lento.
RELEASE_INDEX_TTL=2592000
RELEASE_INDEX_MAX_RELEASES=60

# --- Fase 3: baseline de cobertura BR com raio (3.1) ---
# Observabilidade pura sobre a coorte das listas IMDb: top N filmes + top N
# series, incluindo obras conhecidas e novas. Requer a semente/RAPIDAPI ativa
# para formar a coorte; sem ela a baseline permanece vazia. Mede BR dublado
# nao-lied com raio RD confirmado, sem rede nem escrita no debrid. Metricas e
# gauges zeram no restart; a coorte persiste. F3_ENABLED=false desliga a fase;
# F3_BR_ENABLED=false desliga so o sampler.
F3_ENABLED=true
F3_BR_ENABLED=true
F3_BR_SAMPLE_MS=300000
# Cada lista IMDb devolve ate 100; clamp 1..100 por tipo.
F3_BR_TOP_PER_TYPE=100

# --- Fast-path da conta do debrid ---
# Se o inventario da conta sozinho entrega releases suficientes da obra, a
# resposta sai na hora e o Jackett vai para o tail enriquecer. Titulo novo
# continua no caminho normal.
ACCOUNT_FAST_PATH=true
ACCOUNT_FAST_MIN_RELEASES=2
ACCOUNT_FAST_WAIT_MS=450

# --- Colhedor: fila de obras colhidas em fundo ---
# Generalizacao do warmup: colhe enquanto ninguem usa ha N minutos, com
# orcamento largo. HARVEST_ENABLED=false desliga a fila inteira.
HARVEST_ENABLED=true
HARVEST_INTERVAL_MS=60000
HARVEST_IDLE_WINDOW_MS=600000
HARVEST_QUEUE_MAX=200
# Amostra visível apenas no /dashboard-status.json; não expõe a fila inteira.
HARVEST_QUEUE_PREVIEW=8
HARVEST_DASHBOARD_LAST=10
# Máximo de obras que "Drenar fila agora" processa por clique. O teto horário
# HARVEST_MAX_HOUR continua valendo.
HARVEST_DRAIN_MAX_WORKS=5
# Teto de educacao com os indexers (consultas de colheita por hora) e
# intervalo minimo entre consultas ao MESMO indexer.
HARVEST_MAX_HOUR=30
HARVEST_INDEXER_DELAY_MS=1500
HARVEST_ENTRY_TTL=604800
# Priorizar a fila do colhedor por evidencia BR (Fase 3.2): obra com play
# real (next-episode) ou release BR dublada no indice sai antes na fila.
# Desligar restaura a ordem FIFO exata.
HARVEST_BR_FIRST=true
# Prazo maximo que uma obra sem evidencia BR pode esperar antes de subir na
# frente (bound de fome: obra pedida nao morre de fome). 0 desliga o prazo.
HARVEST_BR_MAX_WAIT_MS=21600000
# URL pública do addon — precisa ser alcançável pelo player. Em casa é o IP da
# LAN (o Fire TV não alcança 127.0.0.1); na VPS é o domínio HTTPS. Errar isto
# não quebra a lista, quebra o PLAY: todo link resolvido no debrid sai daqui.
PUBLIC_URL=http://127.0.0.1:7000
# Domínio que o Caddy serve. Vazio/localhost = certificado interno, sem chamar
# o Let's Encrypt — é o que a instalação em casa quer. Na VPS, o domínio real
# (aceita lista): ADDON_DOMAIN=powermovie.net, www.powermovie.net
ADDON_DOMAIN=localhost
# Onde a porta 7000 escuta. Em casa 0.0.0.0 (Fire TV pela LAN). Na VPS use
# 127.0.0.1: o Caddy passa a ser a única entrada, e a URL de instalação — que
# carrega a chave do debrid no segmento de config — deixa de trafegar sem TLS.
BIND_ADDR=0.0.0.0
# Segredo do HMAC que assina os links /resolve. Vazio = assina com a API key
# de debrid da requisição. Preencha em instância pública para poder trocar a
# key sem invalidar o formato da assinatura.
#
# Preenchido, ele também CIFRA a chave de debrid dentro do install URL
# (AES-256-GCM). Sem ele o segmento é só base64url — codificação, não proteção:
# quem visse o link (histórico, print, log de proxy) lia a chave inteira.
# Ligar depois não quebra ninguém: link antigo com a chave em texto puro
# continua sendo aceito. TROCAR o valor, por outro lado, invalida os links já
# cifrados — quem instalou precisa gerar outro em /configure.
RESOLVE_SECRET=

# Cooldown (ms) da invalidação do cache de streams quando um PLAY descobre 451
# (recusa legal do debrid). A lista pronta foi construída antes do bloqueio ser
# conhecido e continuaria oferecendo [RD⚡] morto até o fim do TTL; a
# invalidação faz a próxima abertura reconstruir a lista sem o hash bloqueado.
# O cooldown existe porque o usuário clicando vários cards bloqueados em
# sequência não pode esfriar o cache de todas as obras repetidamente.
# 0 desliga a invalidação.
RESOLVE_BLOCKED_INVALIDATE_COOLDOWN_MS=30000

# Coluna estreita da lista de streams: compact | full.
# compact deixa ali só qualidade/áudio/BR/seeds ("4K DUB BR · 👤 1"); a release
# inteira fica na coluna larga. full repete a release nas duas — no Stremio isso
# quebra uma palavra por linha e cada stream passa a ocupar ~11 linhas de
# altura. Só use full em cliente que ignora o campo `title`.
STREAM_NAME_STYLE=compact

# Mostra o indexer abreviado no name (o campo que alguns clientes renderizam
# como texto), além do marcador ⚙️ da linha de metadados.
STREAM_NAME_SHOW_SOURCE=true

# Verbosidade do ADDON: silent | error | warn | info | debug.
# Não é LOG_LEVEL — essa já existe no docker-compose.yml e é do FlareSolverr;
# no container único os três processos dividem o mesmo ambiente.
ADDON_LOG_LEVEL=info

# Indexers consultados em paralelo, um timeout por indexer.
# Vazio = usa o agregado /all do Jackett, que espera o indexer mais lento.
JACKETT_INDEXERS=
JACKETT_INDEXER_TIMEOUT_MS=4000
# Cache do catálogo de indexadores exibido na configuração (segundos).
JACKETT_CATALOG_TTL=900
# Tempo que a última latência real fica visível na configuração (segundos).
JACKETT_STATUS_TTL=900
# Circuit breaker: indexer offline em N buscas seguidas deixa de ser
# consultado (o orçamento dele volta para os demais) até a última falha esfriar
# por este cooldown. Indexer vivo porém lento (slow) ou que ainda entrega algo
# (degraded) NÃO quebra o circuito. O diagnóstico /test-indexer.json ignora o
# breaker — é ele quem conserta a fonte.
JACKETT_BREAKER_ENABLED=true
JACKETT_BREAKER_FAILURES=3
JACKETT_BREAKER_COOLDOWN_MS=300000
# Cards BR resolvem páginas WordPress e protetores de link; recebem mais prazo.
# Orçamento TOTAL do indexer: busca + resolução dos magnets, tudo somado.
# PODE passar do REPLY_DEADLINE_MS: a resposta não espera por eles — devolve o
# que chegou e o passe tardio recacheia o lote completo. Abaixo de ~15s a busca
# FRIA não cabe (a raspagem sozinha leva 5-6s) e o indexer inteiro era perdido.
JACKETT_BR_INDEXER_TIMEOUT_MS=20000
# Recebem o orcamento ampliado acima. NAO coloque aqui os que passam por
# FlareSolverr (1337x, kickasstorrents): o desafio Cloudflare e re-resolvido a
# cada busca e leva 13-24s so pra abrir a primeira pagina, entao eles abortam
# de todo jeito. Melhor deixar de fora de JACKETT_INDEXERS.
JACKETT_SLOW_INDEXERS=bludv-cardigann,redetorrent,apachetorrent,hdrtorrent
# Fora do caminho da resposta, DENTRO do sistema: estes indexers nao recebem
# busca ao vivo de usuario nenhum (latencia de 8-31s contra orcamento de 20s
# derrubava-os no breaker e ainda consumia o prazo com o retry PT->titulo
# original). Alimentam o INDICE pelo colhedor, que tem fila persistente e
# orcamento largo; a busca ao vivo serve do indice quando ele cobre a obra.
# Lista vazia restaura a busca ao vivo para todos.
JACKETT_INDEX_ONLY_INDEXERS=redetorrent,apachetorrent,hdrtorrent
# Indexadores Cardigann locais cujo campo Link precisa ser convertido em magnet.
# Os QUATRO entregam Link em vez de magnet; fora desta lista o resultado é
# descartado por falta de infoHash.
JACKETT_RESOLVE_DOWNLOAD_INDEXERS=comandotorrents,nerdfilmes,bludv-cardigann,torrentdosfilmesv2
JACKETT_RESOLVE_CONCURRENCY=6
JACKETT_MAX_DOWNLOAD_RESOLVES=20
# Teto por salto de protetor, DENTRO do orçamento total do indexer acima.
JACKETT_DOWNLOAD_TIMEOUT_MS=8000
# O Link do indexer é input de terceiro: o addon recusa baixar de loopback,
# rede privada, link-local (169.254.169.254 é metadado de nuvem) e afins. Ligue
# só se o SEU resolvedor de magnet mora numa rede privada nesse caminho.
JACKETT_ALLOW_PRIVATE_DOWNLOAD_IPS=false
# Recebem o título localizado do TMDB (ex.: "Coringa" em vez de "Joker").
JACKETT_PT_BR_INDEXERS=bludv-cardigann,comandotorrents,nerdfilmes,torrentdosfilmesv2,redetorrent,apachetorrent,hdrtorrent
# Buscadores WordPress stock que zeram com qualquer token extra na query:
# além do SxxEyy (removido para todo indexer BR), estes perdem também o ano
# do filme ("Coringa 2019" devolve 0 no redetorrent; "Coringa" devolve 34).
JACKETT_BARE_TITLE_INDEXERS=redetorrent,apachetorrent,hdrtorrent
# Varredura tardia (fora do caminho da resposta) com o título pt-BR nos
# indexers GLOBAIS: acha dublado hospedado em tracker global titulado em
# português, que a query em inglês não encontra. Cada busca faz uma segunda
# consulta a todos os globais não-BR selecionados; ela fica fora dos cards de
# status (`recordStatus:false`), compartilha a fila tardia do refresh, e
# ignora o circuit breaker (roda no tail do orçamento, e o indexer recém-
# derrubado é justamente onde o dublado raro mora). Filme usa o título
# pt-BASE sem subtítulo e sem ano (tracker global casa por palavras);
# série continua com a query do SxxEyy/pack. false desliga sem deploy.
JACKETT_PT_SWEEP_GLOBAL=true

# --- Warmup do catálogo bruto no boot ---
# Aquece metadados e raw:v1 antes do primeiro usuário. false desliga tudo.
WARMUP_ENABLED=true
# Lista curada no formato imdbId:tipo, separada por vírgula.
WARMUP_TITLES=tt7286456:movie,tt11198330:movie,tt1630029:movie,tt11126994:series,tt3581920:series,tt2861424:series
# Backpressure: títulos em paralelo, pausa entre indexers e teto total.
WARMUP_CONCURRENCY=2
WARMUP_INDEXER_DELAY_MS=250
WARMUP_TIMEOUT_MS=600000
# true não consulta BR/slow no boot (orçamento de até 20s por indexer).
WARMUP_SKIP_SLOW=true

# --- Resolvedores Locais BR (portas 8700..8703) ---
# Host que os resolvedores BR embutidos usam no próprio SELF_URL. No container
# único o Jackett chama os resolvedores por loopback (127.0.0.1); só mude se
# rodar os resolvedores em outra máquina.
BR_RESOLVERS_HOST=127.0.0.1
# Resolvedores carregados no processo do addon (modo de produção do container
# único). false volta ao modo de processos separados, cada um na própria porta.
BR_RESOLVERS_EMBEDDED=true
# Desloca as quatro portas (8700..8703), útil ao rodar mais de uma instância.
BR_RESOLVERS_PORT_OFFSET=0
BLUDV_URL=https://bludvfilmes.xyz
COMANDOTORRENTS_URL=https://comandotorrents.to
NERDFILMES_URL=https://www.nerdviatorrents.net
TORRENTDOSFILMES_URL=https://torrentdosfilmes-v2.xyz
# Candidatos extras de failover (csv), testados quando o domínio primário
# acima cai. Os mirrors históricos de cada site já entram como candidatos
# automaticamente — aqui só vale o que não está na lista embutida.
BLUDV_URLS=
COMANDOTORRENTS_URLS=
NERDFILMES_URLS=
TORRENTDOSFILMES_URLS=
# Failover de domínio: depois de N buscas seguidas falhando por
# DNS/conexão/timeout, um probe GET /?s=teste troca para o primeiro
# candidato que responder 2xx. O vencedor fica imune a novo probe por este
# TTL (ms) — sondar de novo não ressuscita site caído.
BR_DOMAIN_FAILS_BEFORE_PROBE=2
BR_DOMAIN_PROBE_TTL_MS=1800000
# Domínios adicionais de protetores de link permitidos (separados por vírgula)
EXTRA_ALLOWED_PROTECTORS=
NERDFILMES_SEARCH_CACHE_MS=120000
NERDFILMES_POST_CACHE_MS=600000
NERDFILMES_MAGNET_CACHE_MS=1800000

# --- BLUDV (fonte BR dublada) ---
BLUDV_ENABLED=false
BLUDV_DUBBED_ONLY=true
BLUDV_MAX_POSTS=3
# Teto de links por post e quantos posts raspar em paralelo.
BLUDV_MAX_LINKS=12
BLUDV_CONCURRENCY=6
BLUDV_TIMEOUT_MS=8000

# --- TMDB: resolve título pt-BR (necessário para fontes BR) ---
TMDB_API_KEY=
TMDB_CACHE_TTL=604800
# Teto (ms) de cada chamada ao TMDB.
TMDB_TIMEOUT_MS=5000
# Por quanto tempo (s) um id SEM resultado fica cacheado como "miss". Evita
# bater na API a cada busca para título desconhecido; falha transitória se
# resolve sozinha quando expira. 0 desliga.
TMDB_MISS_TTL=300

# --- Cinemeta: título/ano oficiais do ecossistema Stremio ---
# Roda antes da coleta; se não responder neste prazo, a busca segue com o TMDB
# ou com o IMDb id em vez de consumir o deadline inteiro do cliente.
CINEMETA_TIMEOUT_MS=2500
# Cache negativo do Cinemeta (mesma função do TMDB_MISS_TTL). 0 desliga.
CINEMETA_MISS_TTL=300

# --- Semente do colhedor (RapidAPI / imdb236) -------------------------------
# As listas de populares do IMDb viram fila de obras a indexar ANTES de alguem
# pedir. Sem a chave o modulo e INERTE: nao faz requisicao nenhuma.
# Custo medido: 100 titulos por requisicao, 2 requisicoes por ciclo.
RAPIDAPI_KEY=
# SEED_ENABLED=true
# SEED_MAX_PER_CYCLE=20     # teto por ciclo; o gargalo e a vazao do colhedor
# SEED_MIN_VOTES=1000       # piso de publico: popular sem votos e ruido
# SEED_INTERVAL_H=24        # cooldown entre ciclos
# RAPIDAPI_IMDB_HOST=imdb236.p.rapidapi.com
