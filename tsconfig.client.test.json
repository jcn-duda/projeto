{
  // Segundo emit dos MESMOS fontes de src/client, agora como NodeNext/ES2022
  // em dist/src/client. É o que permite os testes importarem os módulos de
  // verdade no Node (com DOM falso injetado) sem o bundle de browser e sem
  // puxar o cliente para dentro do programa do tsconfig raiz.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src/client",
    "outDir": "dist/src/client",
    "noEmitOnError": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/client/**/*.ts"]
}
