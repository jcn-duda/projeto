    {"id":"ns-022","input":"{\"raw\":\"http://user:pass@tracker.example/dl\",\"allowPrivate\":false}","note":"userinfo não troca o host"},
    {"id":"ns-023","input":"{\"raw\":\"not a url\",\"allowPrivate\":false}","note":"sem esquema"},
    {"id":"ns-024","input":"{\"raw\":\"http://[fd00::1]/file\",\"allowPrivate\":false}","note":"ULA fd00"}
